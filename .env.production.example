# Copy this file to .env.production and fill in your production Firebase
# project's real Web SDK config (Firebase Console -> Project Settings ->
# General -> Your apps -> Web app). .env.production is gitignored and never
# committed — in CI, set these as pipeline secrets instead of a checked-in file.
API_URL=https://api.narturebelle.com/api/v1
# NB-Ecom-Mails-API: reminders and notification preferences. Leave unset until it's deployed; they stay on API_URL.
# MAILS_API_URL=https://<mails-api-host>/api/v1
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=narturebelle-app.firebaseapp.com
FIREBASE_PROJECT_ID=narturebelle-app
FIREBASE_STORAGE_BUCKET=narturebelle-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
